EDUSENSE_SECRET_KEY=change-this-local-secret
EDUSENSE_DATABASE_URL=postgresql+psycopg2://edusense:edusense@localhost:5432/edusense
# SQLite fallback (no Docker): sqlite:///./edusense.db
EDUSENSE_ACCESS_TOKEN_MINUTES=1440
EDUSENSE_ENGAGEMENT_THRESHOLD=62

# ── AI Provider ──────────────────────────────────────────────────────────────
# "gemini" / "auto" = Uses Gemini online. If internet drops/fails -> auto-falls back to Ollama offline!
# "ollama" = Always use local Ollama offline
# "local"  = Built-in deterministic templates (no AI, no internet, no setup)
EDUSENSE_AI_PROVIDER=gemini


# Gemini (online) — get a FREE key at https://aistudio.google.com
# Store this in .env only — NEVER commit the real key to git (.env is gitignored)
EDUSENSE_GEMINI_API_KEY=
EDUSENSE_GEMINI_MODEL=gemini-2.0-flash

# Ollama (offline 4-model system) — run:
#   ollama pull qwen2.5     (7B model: best for Arabic/multilingual translation & input processing)
#   ollama pull mistral     (7B model: best for detailed lessons, slides & scripts)
#   ollama pull llama3.1    (8B model: best reasoning for quizzes & assessments)
#   ollama pull llama3.2    (3B model: fast generation for flashcards & general fallback)
EDUSENSE_OLLAMA_URL=http://localhost:11434/api/generate
EDUSENSE_OLLAMA_MODEL=llama3.2
EDUSENSE_OLLAMA_MODEL_TRANSLATION=qwen2.5
EDUSENSE_OLLAMA_MODEL_LESSON=mistral
EDUSENSE_OLLAMA_MODEL_QUIZ=llama3.1
EDUSENSE_OLLAMA_MODEL_FLASHCARD=llama3.2




EDUSENSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Frontend URL (used in reminder emails) ────────────────────────────────────
EDUSENSE_FRONTEND_URL=http://localhost:5173

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Gmail setup:
#  1. Enable 2-Step Verification on your Google account
#  2. Go to https://myaccount.google.com/apppasswords
#  3. Create an App Password for "Mail" → copy the 16-character code
#  4. Paste it as EDUSENSE_SMTP_PASSWORD below (NOT your Gmail login password)
EDUSENSE_SMTP_HOST=smtp.gmail.com
EDUSENSE_SMTP_PORT=587
EDUSENSE_SMTP_USER=edusense.eg@gmail.com
EDUSENSE_SMTP_PASSWORD=your-16-char-app-password-here
EDUSENSE_SMTP_FROM_EMAIL=EduSense <edusense.eg@gmail.com>

